        "jsCode": "const rawInput = $json.input || $json.id_pedido || $fromAI('id_pedido');\nconst id = String(rawInput || '').trim();\n\nconst baseDatos = {\n  \"101\": { pedido_id: \"101\", cliente: \"Carlos Pérez\", estado: \"En camino\", producto: \"Teclado Mecánico Ergonómico\", valor: 350000 },\n  \"102\": { pedido_id: \"102\", cliente: \"Ana Gómez\", estado: \"Entregado\", producto: \"Monitor 24 pulgadas IPS\", valor: 850000 },\n  \"103\": { pedido_id: \"103\", cliente: \"Juan Pablo Bedoya\", estado: \"Aprobado - Pendiente Despacho\", producto: \"Laptop Dell Latitude\", valor: 4200000 }\n};\n\nif (baseDatos[id]) {\n  return JSON.stringify(baseDatos[id]);\n} else {\n  return JSON.stringify({ error: `El pedido con ID ${id} no existe en el sistema Compra360.` });\n}"
