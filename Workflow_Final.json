        "text": "={{ $json.descripcion }}",
        "messages": {
          "messageValues": [
            {
              "message": "Eres un evaluador y clasificador corporativo de adquisiciones en Compra360. Analiza la descripción de la compra y responde ÚNICAMENTE un objeto JSON válido con este formato estricto:\n{\n  \"clasificacion\": \"EQUIPO | MOBILIARIO | CONSUMIBLE | OTROS\",\n  \"prioridad\": \"ALTA | MEDIA | BAJA\",\n  \"justificacion\": \"breve justificación técnica del motivo\"\n}"
            }
          ]
        },
        "batching": {}
      },
      "id": "node-basic-llm-009",
      "name": "Basic LLM Chain - Clasificación Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        940,
        100
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {}
      },
      "id": "node-gemini-model-010",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        940,
        260
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "ZqAN682zfbUePxen",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let rawText = $input.first().json.text || '';\nlet parsed = {};\ntry {\n  const cleanJson = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleanJson);\n} catch (e) {\n  parsed = {\n    clasificacion: 'OTROS',\n    prioridad: 'MEDIA',\n    justificacion: 'Evaluación automática heurística por descripción general'\n  };\n}\n\nconst norm = $('Normalizar solicitud').first().json;\n\nreturn [{\n  json: {\n    ...norm,\n    decision: 'REQUIERE APROBACIÓN',\n    nivel: 'Nivel 2 – Jefe de Área',\n    motivo: `Compra categorizada por IA como ${parsed.clasificacion} (${parsed.prioridad})`,\n    requiere_aprobacion: true,\n    estado: 'Pendiente Aprobación por Área',\n    area_aprobadora: 'Dirección de Área',\n    clasificacion_ia: parsed.clasificacion || 'OTROS',\n    prioridad_ia: parsed.prioridad || 'MEDIA',\n    justificacion_ia: parsed.justificacion || 'Revisión por comité'\n  }\n}];"
      },
